    "cheerio": "^1.2.0",
    "chromium-bidi": "15.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "geotiff": "^3.0.5",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
