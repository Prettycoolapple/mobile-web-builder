{
  "expo": {
    "name": "Project Alpha",
    "slug": "workspace",
    "version": "1.2.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "devfeasible",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1917"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nz.devfeasible.app",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nz.devfeasible.app",
      "versionCode": 6,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1C1917"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1C1917"
        }
      ],
      "expo-dev-client",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D97757",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d24f94f9-0041-43da-8cc8-036b39127668"
      }
    }
  }
}
