{
  "expo": {
    "name": "Project Alpha",
    "slug": "workspace",
    "version": "1.4.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "devfeasible",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1917"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nz.devfeasible.app",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nz.devfeasible.app",
      "versionCode": 9,
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1C1917"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1C1917"
        }
      ],
      "expo-dev-client",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D97757",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "2265538447515304",
          "clientToken": "02dfcb5788c6a9dfab5c4634a395abdc",
          "displayName": "projectalpha.app",
          "scheme": "fb2265538447515304",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": false,
          "iosUserTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d24f94f9-0041-43da-8cc8-036b39127668"
      }
    }
  }
}
