# -----------------------------------------------------------------------------
# Local LAN dev (Expo Go QR scan against your local API)
# -----------------------------------------------------------------------------
# When unset, the app auto-detects your Metro LAN host (so QR scanning just
# works for devices on the same Wi-Fi). Set this explicitly only if the
# autodetect picks the wrong interface or you point at a hosted API.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_APP_URL=
EXPO_PUBLIC_API_PORT=8080

# Legacy fallback still supported. Prefer EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_DOMAIN=

# -----------------------------------------------------------------------------
# Realtime
# -----------------------------------------------------------------------------
# true:  connect to the API's Socket.IO for live DMs (self-hosted API).
# false: poll /dm/threads periodically instead (required for Vercel-hosted API).
EXPO_PUBLIC_ENABLE_SOCKETS=true
# Polling interval in milliseconds when sockets are disabled or unreachable.
EXPO_PUBLIC_DM_POLL_MS=10000

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------
# Expo Go always uses simulated billing. Real Apple/Google IAP requires a
# dev-client or store build, not Expo Go.
EXPO_PUBLIC_USE_TEST_PAYMENT=false
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
