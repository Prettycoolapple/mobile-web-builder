# -----------------------------------------------------------------------------
# Runtime / hosting
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=true

# When running on Vercel-compatible serverless, Socket.IO cannot be hosted.
# Set to "false" for Vercel (or any stateless serverless) deployments.
# The mobile app polls DM threads instead when sockets are disabled.
ENABLE_SOCKET_IO=true

# -----------------------------------------------------------------------------
# Database (Supabase)
# -----------------------------------------------------------------------------
# Supabase: Dashboard → your project → Project Settings (gear) → Database.
# Under "Connection string", pick URI, choose the right mode:
# - Session pooler or Direct (5432): good for drizzle-kit push and local API.
# - Transaction pooler (6543): typical for Vercel/serverless.
# Replace [YOUR-PASSWORD] with the database password (Database → Database password).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
PGSSL=

# Optional Supabase admin URLs and keys, used only if you later add Supabase
# auth, storage, or edge functions. The Express API does not need these today.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# Base URL used for Stripe redirects and any absolute links the API generates.
# In production set this to your Vercel app URL (for example https://your-app.vercel.app).
PUBLIC_APP_URL=http://localhost:8080
# Public store fallback URLs used by shared property pages when the app is not installed.
IOS_APP_STORE_URL=https://apps.apple.com/nz/app/project-alpha/id6762080292
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=nz.devfeasible.app

# -----------------------------------------------------------------------------
# Auth / session secrets
# -----------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string
# Optional separate secret for owner/admin certificate review links.
# Falls back to SESSION_SECRET when omitted.
FILE_REVIEW_SECRET=
PHONE_VERIFICATION_SECRET=replace-with-another-long-random-string

# -----------------------------------------------------------------------------
# Stripe (web billing only; iOS/Android use native IAP via RevenueCat)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Twilio SMS (OTP)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# File storage — Supabase Storage (recommended — you already use Supabase DB)
# -----------------------------------------------------------------------------
# Supabase Storage has an S3-compatible API, so no extra SDK or vendor needed.
# Since you already have a Supabase project for the database, this is the
# simplest option — one dashboard, one bill, zero extra accounts.
#
# Setup (~3 minutes):
#   1. Supabase Dashboard → Storage → New bucket
#      Name: "listings"   Make it PUBLIC (so listing photos load without a token)
#      Name: "documents"  Keep it PRIVATE (LIM reports, title docs are sensitive)
#      (You can use a single bucket too — just set S3_BUCKET_NAME to its name)
#   2. Project Settings → Storage → S3 Connection
#      Copy: Endpoint, Region, Access Key ID, Secret Access Key
#   3. For the public URL (S3_PUBLIC_URL), use:
#      https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
#   4. Paste the values below and in Vercel → Project Settings → Environment Variables
#
# If S3_* vars are set they take priority over GCS for all upload types.
# Leave all blank to fall back to GCS (if configured) or inline base64 storage.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=listings
# Set to your public bucket URL so listing photos are served directly from
# Supabase (no API proxy). Leave blank to proxy all files through the API.
# Example: https://<project-ref>.supabase.co/storage/v1/object/public/listings
S3_PUBLIC_URL=

# --- Cloudflare R2 (alternative — zero egress fees if images are high-traffic)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_NAME=project-alpha
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# -----------------------------------------------------------------------------
# Google Cloud Storage (alternative — used if S3_* vars are not set)
# -----------------------------------------------------------------------------
# Format: /bucket-name/prefix (leading slash required).
# Example: PRIVATE_OBJECT_DIR=/my-bucket/private
#          PUBLIC_OBJECT_SEARCH_PATHS=/my-bucket/public
GOOGLE_CLOUD_PROJECT_ID=
PUBLIC_OBJECT_SEARCH_PATHS=/your-public-bucket/public
PRIVATE_OBJECT_DIR=/your-private-bucket/private
# Local dev: set GOOGLE_APPLICATION_CREDENTIALS to a JSON key file on disk.
# Vercel / hosted: paste the full service-account JSON (one line) into
# GOOGLE_APPLICATION_CREDENTIALS_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# -----------------------------------------------------------------------------
# Third-party APIs
# -----------------------------------------------------------------------------
# Used by api-server: Geocoding, Elevation, Street View Static, Maps Static (satellite /staticmap).
# In Google Cloud Console enable: Geocoding API, Elevation API, Street View Static API, Maps Static API; set billing.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
LINZ_API_KEY=
SCRAPINGBEE_API_KEY=

# Redevelopment detection (api-server):
# LINZ_CHILD_ADDRESS_PROBE=1 enables the LRS child-address probe — querying the
# parent address for unit-style children ("1/6, 2/6 … 10/6") to detect parcels
# already developed into multiple dwellings. Off by default until verified live.
LINZ_CHILD_ADDRESS_PROBE=
# Days before cached property data is re-acquired live (default 90).
PROPERTY_CACHE_TTL_DAYS=

# Optional but recommended on Vercel: remote Playwright browser for scrapers
# that need rendered pages (QV, OneRoof, Hougarden). Examples:
# PLAYWRIGHT_CDP_ENDPOINT=wss://your-browserless-host?token=...
# or set BROWSERLESS_TOKEN and optionally BROWSERLESS_HOST=production-sfo.browserless.io
PLAYWRIGHT_CDP_ENDPOINT=
BROWSERLESS_WS_ENDPOINT=
BROWSERLESS_TOKEN=
BROWSERLESS_HOST=
PLAYWRIGHT_CDP_TIMEOUT_MS=30000
MAX_BROWSER_SLOTS=3

# Gmail: use an App Password on a Google Account with 2FA (not your normal login password).
# Used only for owner/admin notifications such as signups and support requests.
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# Resend transactional email for user-facing messages such as password resets.
# The domain part of RESEND_FROM_EMAIL must be added and verified in the Resend dashboard
# (Domain → yourdomain.com). Once verified, messages send with your custom domain as the sender.
# Use a no-reply-style address, e.g. Project Alpha <no-reply@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: full URL shown in transactional emails (password reset, etc.) for web support.
# Example: https://projectalpha.app/support
PUBLIC_SUPPORT_URL=

# AI provider selection:
# - gemini (default)
# - deepseek (OpenAI-compatible)
# - grok (OpenAI-compatible)
# - openai_compat (generic OpenAI-compatible endpoint)
AI_PROVIDER=gemini
# When AI_PROVIDER=gemini, automatically fail over to OpenAI-compatible provider
# for quota/outage/network-type failures if compat credentials are configured.
AI_FAILOVER_ENABLED=true

# Gemini config
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# OpenAI-compatible config (used when AI_PROVIDER=deepseek|grok|openai_compat)
# Also used as Gemini failover target when AI_PROVIDER=gemini and failover enabled.
# Examples:
# - DeepSeek base URL: https://api.deepseek.com/v1
# - xAI Grok base URL: https://api.x.ai/v1
AI_OPENAI_COMPAT_API_KEY=
AI_OPENAI_COMPAT_BASE_URL=
# Optional model mapping from existing gemini call sites:
# - *_FAST is used when call site requested a "flash" model
# - *_PRO is used for all other models
AI_OPENAI_COMPAT_MODEL_FAST=
AI_OPENAI_COMPAT_MODEL_PRO=
AI_OPENAI_COMPAT_MODEL_DEFAULT=

# -----------------------------------------------------------------------------
# RevenueCat admin (used only by scripts/seed:revenuecat)
# -----------------------------------------------------------------------------
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_TEST_STORE_APP_ID=
REVENUECAT_APPLE_APP_STORE_APP_ID=
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID=
