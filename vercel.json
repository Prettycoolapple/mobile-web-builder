{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/api-server run build",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "outputDirectory": "artifacts/api-server/deploy",
    "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "api/vercel-app.mjs"
    }
  },
  "redirects": [
    { "source": "/support", "destination": "/contact", "permanent": true },
    { "source": "/support/", "destination": "/contact", "permanent": true },
    { "source": "/sales-portal", "destination": "/sales-portal/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/healthz", "destination": "/api/healthz" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/share/(.*)", "destination": "/api/share/$1" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" }
  ],
  "env": {
    "ENABLE_SOCKET_IO": "false"
  }
}
