{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/api-server run build",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "outputDirectory": "artifacts/api-server",
  "functions": {
    "artifacts/api-server/api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/artifacts/api-server/api/index" },
    { "source": "/api", "destination": "/artifacts/api-server/api/index" }
  ],
  "env": {
    "ENABLE_SOCKET_IO": "false"
  }
}
